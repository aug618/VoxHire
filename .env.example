# OpenAI-compatible LLM configuration. Copy this file to .env and fill it in.
VOXHIRE_LLM_BASE_URL=https://api.example.com/v1
VOXHIRE_LLM_API_KEY=replace-with-your-api-key
VOXHIRE_LLM_MODEL=your-model-name

# CPU is the reliable default. Set to cuda only after verifying the 4GB GPU path.
VOXHIRE_DEVICE=cpu

# The local speech-to-speech WebSocket endpoint used by the React application.
VOXHIRE_GATEWAY_HOST=127.0.0.1
VOXHIRE_GATEWAY_PORT=8765
